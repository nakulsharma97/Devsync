# DevSync — Render environment variables (placeholders only, no secrets).
#
# Paste this into Render → your service → Environment → "Add from .env",
# then replace every REPLACE_* value. Never commit a filled-in copy.
#
# The Aiven CA certificate is NOT an environment variable: upload it as a
# Render Secret File named `aiven-ca.pem` (mounted at /etc/secrets/aiven-ca.pem).

# ── Required ──────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:mysql://REPLACE_AIVEN_HOST:REPLACE_AIVEN_PORT/defaultdb?sslMode=VERIFY_IDENTITY&trustCertificateKeyStoreUrl=file:/app/certs/aiven-truststore.p12&trustCertificateKeyStoreType=PKCS12&trustCertificateKeyStorePassword=changeit&serverTimezone=UTC&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=avnadmin
SPRING_DATASOURCE_PASSWORD=REPLACE_AIVEN_PASSWORD
# Generate: openssl rand -base64 64  (>= 32 chars; 64 bytes is recommended)
JWT_SECRET=REPLACE_RANDOM_64_BYTE_BASE64

# ── Public URL (same origin: nginx serves the SPA and proxies the API) ──
DEVSYNC_CORS_ORIGINS=https://REPLACE_APP.onrender.com
FRONTEND_URL=https://REPLACE_APP.onrender.com
DEVSYNC_COOKIE_SECURE=true
DEVSYNC_TRUST_X_FORWARDED_FOR=true
UPLOAD_DIR=/app/uploads

# ── Email (required for signup OTP, password reset, verification) ──
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=REPLACE_YOUR_ADDRESS@gmail.com
# Gmail App Password (16 chars, no spaces) — not the account password
MAIL_PASSWORD=REPLACE_GMAIL_APP_PASSWORD

# ── Optional: social login ───────────────────────────────────────
# Enabling these also requires SPRING_PROFILES_ACTIVE=prod,oauth.
# The oauth profile declares BOTH providers without defaults, so set all four.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Optional: GitHub repository integration ─────────────────────
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=https://REPLACE_APP.onrender.com/api/github/callback
# GITHUB_WEBHOOK_SECRET=
# GITHUB_TOKEN_ENCRYPTION_KEY=

# ── Optional: payments (checkout returns 503 while unset) ───────
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_SUCCESS_URL=https://REPLACE_APP.onrender.com/settings/billing?payment=success
# STRIPE_CANCEL_URL=https://REPLACE_APP.onrender.com/settings/billing?payment=cancelled

# ── Optional: one-time admin bootstrap (set back to false afterwards) ──
DEVSYNC_ADMIN_SEED_ENABLED=false
# DEVSYNC_ADMIN_EMAIL=
# DEVSYNC_ADMIN_PASSWORD=
