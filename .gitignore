# ── OS / IDE ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.sw?
*.suo
*.ntvs*
*.njsproj
*.sln
.idea
.vscode/*
!.vscode/extensions.json

# ── Dependencies ──────────────────────────────────────────────
node_modules/
**/package-lock.json

# ── Build output ──────────────────────────────────────────────
dist/
dist-ssr/
**/target/
coverage/

# ── Environment files — never commit secrets ─────────────────
.env
.env.*
!.env.example
!.env.development

# ── Local uploads (user-generated, per-environment) ──────────
backend/uploads/

# ── Database backups (never in source control) ───────────────
*.sql
!backend/src/main/resources/db/migration/*.sql

# ── Local DB TLS certificates (see scripts/generate-db-certs.sh) ──
certs/

# ── Logs ──────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
bun-debug.log*
lerna-debug.log*

# ── Freebuff local dev-tool artifacts ────────────────────────
.freebuff/


# ── TypeScript build info files ──────────────────────────────
*.tsbuildinfo

# ── Misc ──────────────────────────────────────────────────────
*.local



