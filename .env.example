# ── DevSync environment (example) ─────────────────────────────────
# Copy to `.env` and fill in real values. NEVER commit `.env`.

# ── Required ──────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=

# MySQL
MYSQL_ROOT_PASSWORD=
# Password for the dedicated `devsync` application user
MYSQL_PASSWORD=

# ── Optional ──────────────────────────────────────────────────────
# Frontend origins allowed by CORS (comma-separated, exact match)
DEVSYNC_CORS_ORIGINS=http://localhost:80,http://localhost:5173

# Only true when the app is behind YOUR reverse proxy
DEVSYNC_TRUST_X_FORWARDED_FOR=true

# Invitation / join-request spam protection: max POSTs per user (or IP) per minute
# DEVSYNC_RATE_LIMIT_INVITE_PER_MINUTE=10

# Opt-in bootstrap admin (disabled by default)
DEVSYNC_ADMIN_SEED_ENABLED=false
DEVSYNC_ADMIN_EMAIL=
DEVSYNC_ADMIN_PASSWORD=

# ── Tokens ────────────────────────────────────────────────────────
# Access-token lifetime in ms. Default 900000 (15 min) — a stolen access
# token is only usable briefly. Shorter is safer; longer is more convenient.
DEVSYNC_JWT_ACCESS_EXPIRATION_MS=900000
# Refresh-token lifetime in ms. Default 2592000000 (30 days). Rotated on use.
DEVSYNC_JWT_REFRESH_EXPIRATION_MS=2592000000
# Set true (DEVSYNC_COOKIE_SECURE=true) when serving over HTTPS — marks the
# refresh-token cookie Secure so it is never sent over plain HTTP.
DEVSYNC_COOKIE_SECURE=false

# SMTP for OTP emails
MAIL_USERNAME=
MAIL_PASSWORD=

# OAuth providers (server-side login flow)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub integration (repo linking, commits/issues/PRs) — reuses the
# GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET above.
# Public callback URL, e.g. https://api.example.com/api/github/callback
GITHUB_REDIRECT_URI=
# Secret for verifying GitHub webhook signatures (set in the repo's webhook settings)
GITHUB_WEBHOOK_SECRET=
# Separate key for encrypting GitHub tokens at rest (falls back to JWT_SECRET)
GITHUB_TOKEN_ENCRYPTION_KEY=

# ── WebSocket rate limiting (per user, per minute) ────────────────
# In-memory buckets — single instance only. Move to Redis when scaling out.
DEVSYNC_WS_RATE_LIMIT_ENABLED=true
DEVSYNC_WS_RATE_LIMIT_MAX_MESSAGES=120
DEVSYNC_WS_RATE_LIMIT_MAX_SUBSCRIPTIONS=30

# ── Database TLS (production) ─────────────────────────────────────
# Generate certificates with ./scripts/generate-db-certs.sh — docker-compose
# mounts ./certs into both MySQL and the backend and connects with
# useSSL=true&sslMode=VERIFY_CA. For a local non-TLS MySQL, override:
#   SPRING_DATASOURCE_URL="jdbc:mysql://localhost:3306/devsync_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC"
