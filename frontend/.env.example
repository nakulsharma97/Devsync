# ── DevSync frontend environment variables ──────────────────────────────
# Vite exposes variables prefixed with VITE_ to client code at BUILD time.
# They are baked into the bundle, so set them before `vite build` (or via the
# Docker build args VITE_API_URL / VITE_WS_URL).
#
# Development (used by `vite` / `npm run dev` — see .env.development):
VITE_API_URL=http://localhost:8080/api
VITE_WS_URL=http://localhost:8080/ws
#
# Production (used by `vite build` — see .env.production). Same-origin paths
# are served by the nginx reverse proxy, so no hostname is hardcoded and
# ws/wss is derived from the page protocol automatically:
#   VITE_API_URL=/api
#   VITE_WS_URL=/ws
